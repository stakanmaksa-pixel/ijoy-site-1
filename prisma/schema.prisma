// Prisma schema для iJoy
// Модель данных описана в claude/tz-plan.md проекта

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Каталог ----------

model Category {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  icon       String?
  // Набор атрибутов, доступных для товаров этой категории (память/цвет/регион и т.п.),
  // чтобы новые категории можно было добавлять без правки кода.
  attributes Json?
  sortOrder  Int      @default(0)
  products   Product[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  brand       String?
  images      String[]       @default([])
  status      ProductStatus  @default(DRAFT)
  category    Category       @relation(fields: [categoryId], references: [id])
  categoryId  String
  variants    ProductVariant[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
}

model ProductVariant {
  id          String    @id @default(cuid())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  memory      String?
  color       String?
  // Регион/маркировка устройства, как в прайсе (флаг, код страны и т.п.)
  region      String?
  sku         String?   @unique
  // NULL — для сгенерированной, но отсутствующей в прайсе комбинации
  // (память/цвет/тип SIM), которой реально нет ни в одной строке прайса;
  // на сайте вместо цены показывается "Уточняйте у менеджера", оформление
  // заказа для такой модификации уходит как заявка на уточнение без
  // привязки к цене (см. ProductOrder.tsx).
  price       Decimal?  @db.Decimal(12, 2)
  inStock     Boolean   @default(true)
  // Исходная строка из прайса — для трассировки происхождения цены
  rawLabel    String?
  orderItems  OrderItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId])
}

// ---------- Заказы ----------

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

// Способ и статус оплаты — задел под будущее подключение онлайн-оплаты,
// сейчас реально используются только NONE / NOT_REQUIRED.
enum PaymentMethod {
  NONE
  CASH
  CARD_ON_DELIVERY
  ONLINE
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  customerName  String
  customerPhone String
  customerEmail String?
  comment       String?
  status        OrderStatus   @default(NEW)
  paymentMethod PaymentMethod @default(NONE)
  paymentStatus PaymentStatus @default(NOT_REQUIRED)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id           String         @id @default(cuid())
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  variantId    String
  quantity     Int            @default(1)
  priceAtOrder Decimal        @db.Decimal(12, 2)

  @@index([orderId])
  @@index([variantId])
}

// ---------- Блог ----------

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      ArticleStatus @default(DRAFT)
  author      AdminUser?    @relation(fields: [authorId], references: [id])
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ---------- Импорт прайса от Telegram-бота ----------

enum ImportBatchStatus {
  PENDING
  PARTIALLY_APPLIED
  APPLIED
  REJECTED
}

model PriceImportBatch {
  id           String            @id @default(cuid())
  source       String            @default("telegram-bot")
  rawText      String
  status       ImportBatchStatus @default(PENDING)
  lines        PriceImportLine[]
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedBy   AdminUser?        @relation(fields: [reviewedById], references: [id])
  reviewedById String?
}

enum ImportLineStatus {
  PENDING
  MATCHED
  NEW_VARIANT
  ACCEPTED
  REJECTED
  ERROR
}

model PriceImportLine {
  id               String            @id @default(cuid())
  batch            PriceImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId          String
  rawLine          String
  parsedModel      String?
  parsedMemory     String?
  parsedColor      String?
  parsedRegion     String?
  parsedPrice      Decimal?          @db.Decimal(12, 2)
  matchedVariantId String?
  status           ImportLineStatus  @default(PENDING)
  note             String?

  @@index([batchId])
}

// ---------- Админка ----------

enum AdminRole {
  OWNER
  EDITOR
}

model AdminUser {
  id              String              @id @default(cuid())
  login           String              @unique
  passwordHash    String
  role            AdminRole           @default(EDITOR)
  createdAt       DateTime            @default(now())
  articles        Article[]
  reviewedBatches PriceImportBatch[]
}

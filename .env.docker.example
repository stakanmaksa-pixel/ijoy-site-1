# Для docker-compose: скопируйте в .env.docker и заполните,
# затем запускайте: docker compose --env-file .env.docker up -d --build

POSTGRES_USER=ijoy
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ijoy

BOT_API_TOKEN=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME

# Автосбор прайсов из Telegram-источников; в Cartel бот запрашивает прайс
# только нажатием кнопки «Полный прайс лист».
# API_ID/API_HASH выдаются Telegram на my.telegram.org. Каналы: @username
# или числовые ID через запятую. Сама пользовательская сессия хранится
# в зашифрованной базе TDLib внутри отдельного Docker volume; секреты не
# коммитьте в Git и не отправляйте в чаты.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_DB_ENCRYPTION_KEY=
TELEGRAM_SOURCE_CHANNELS=@stock_msk,@xiaomiopt,@DremeAisha,@MiSmartShopA1016,@CartelPricesBot
TELEGRAM_SCHEDULE=11:00,14:00,17:30
TELEGRAM_TIMEZONE=Europe/Moscow
TELEGRAM_POLL_INTERVAL_SECONDS=30
TELEGRAM_INITIAL_LOOKBACK_HOURS=24
TELEGRAM_QUIET_MINUTES=5
TELEGRAM_SLOT_GRACE_MINUTES=30

# Уведомления о заявках
TELEGRAM_NOTIFICATIONS_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
RESEND_API_KEY=
ORDER_EMAIL_FROM="iJoy <orders@your-domain.ru>"
ORDER_EMAIL_TO=
DADATA_API_KEY=
